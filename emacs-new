;;
;; TEMPLATE — NOT WIRED IN YET.  Do not symlink or load this file.
;; One (elpaca ...) declaration per emacs.d/ submodule (109 total), pinned via inline
;; :ref to the exact commit the submodule gitlink points at, each followed by that
;; package's config lifted verbatim from emacs.d/neph/neph-init.el into the body.
;; Declaration order mirrors the load-path order of the current `emacs' file.
;;
;; Elpaca bootstrap is intentionally absent; at wiring time it goes at the marker
;; below.  Grep TODO-elpaca for everything that needs a decision at wiring time.
;;
;; Semantics to remember (verified against elpaca master, installer 0.12):
;;  - All (elpaca ...) forms enqueue during init; installation/builds run from
;;    after-init-hook; declaration BODIES run after the ENTIRE queue finishes, in
;;    declaration order.  Config that today runs during init (theme load, global
;;    modes) shifts to post-init.  In particular neph-init's custom-set-variables
;;    monolith runs during init, so it will run BEFORE these bodies instead of
;;    after them — override direction flips vs today; see per-block TODO-elpaca
;;    notes for the affected variables.
;;  - A failed package drops its body and cascades failure to dependents, loudly.
;;  - Never use :wait in this file (it would break later-declared dependencies).
;;  - Repos land in <elpaca-directory>/sources/<basename-of-:repo>.  Zero-network
;;    migration: pre-seed each sources/<basename> by moving the existing submodule
;;    checkout (dir -> basename map derives from .gitmodules; no basename
;;    collisions exist).  Do NOT pre-seed builds/.
;;
;; Accounting notes:
;;  - .gitmodules contains a stale stanza "emacs.d/clang-complete-async.git" with
;;    no gitlink; intentionally absent here.
;;  - Old `emacs' line 64 adds nonexistent "~/.emacs.d/jsonrpc-1.0.24" (dead); the
;;    real jsonrpc submodule is declared below.
;;  - Deliberately NOT translated (stays in neph-init): built-in-emacs config, the
;;    neph-base-cfg/neph-space-cfg/neph-tab-cfg hub functions (2367-2563), modeline
;;    (1826-2032), Custom-binds section (2711-3443), dead rtags blocks (1365-1536,
;;    1565-1695), custom-set-variables/faces monolith (3645-3791), default font
;;    (3602-3607).

;; This nonsense has to be set before *any* LSP stuff is touched or loaded by
;; e.g. compile-directory  [lifted from ~/.emacs:1-2; elpaca builds byte-compile
;; in child processes that inherit this environment]
(setenv "LSP_USE_PLISTS" "true")

;; Don't load outdated .elc files, it's basically never what was intended.
;; [lifted from ~/.emacs:4-5]
(setq load-prefer-newer t)

;; ---------------------------------------------------------------------------
;; Elpaca safety rails — fail closed, no network beyond the pinned repos.
;; ---------------------------------------------------------------------------

;; Recipes may come ONLY from the declarations in this file.  Must be evaluated
;; before the first (elpaca ...) form: menu lookup happens at declaration time,
;; and the default menus would git-clone MELPA on first use.
(setq elpaca-menu-functions '(elpaca-menu-declarations))

;; TODO-elpaca: << elpaca bootstrap block goes here at wiring time (installer
;; pinned to a reviewed commit; its recipe is self-contained and menu-free). >>

(with-eval-after-load 'elpaca
  ;; Today's init has no version checking at all (no package.el); pinned commits
  ;; are reviewed as a working set.  elpaca-check-version would hard-fail any
  ;; package whose Package-Requires minimum exceeds a pinned dep's Version:
  ;; header, so disable the step globally for parity.
  ;; TODO-elpaca: partial rebuilds (built dependent + deleted dep build dir)
  ;; re-add the check at runtime; if that ever fires, the failure message names
  ;; the exact package/version — decide then between bumping the pin and
  ;; per-recipe :build (:not elpaca-check-version).
  (setq elpaca-default-build-steps
        (delq 'elpaca-check-version elpaca-default-build-steps))
  ;; Features that Package-Requires may name but which must never be installed:
  ;; provided by a sibling file in an already-declared repo's build, vendored
  ;; below, or genuinely absent today (in which case dependents already cope).
  (setq elpaca-ignored-dependencies
        (append elpaca-ignored-dependencies
                '(helm-core   ; ships in the helm repo's build
                  counsel     ; ships in the swiper repo's build (declared as ivy)
                  swiper      ; ships in the swiper repo's build (declared as ivy)
                  lv          ; ships in the hydra repo's build
                  magit-section ; ships in the magit repo's build
                  pos-tip     ; vendored plain dir (load-path above/below)
                  ;; TODO-elpaca: wfnames (helm) and cfrs (treemacs) are real
                  ;; upstream deps that are simply absent today; behavior is
                  ;; unchanged, but wanting those features later means adding
                  ;; pinned declarations for them.
                  wfnames
                  cfrs
                  ;; TODO-elpaca: goto-chg is named by evil-pkg.el but absent
                  ;; today too — and evil itself is never loaded (its config is
                  ;; fully commented in neph-init).  Without this entry the
                  ;; fail-closed setup would fail evil's build outright.
                  goto-chg
                  request-deferred)))) ; ships in the request repo's build;
                                       ; only matters if the disabled ycmd
                                       ; stack is ever re-enabled
;; NOTE: transient, jsonrpc, and compat are built into modern Emacs but pinned
;; submodules here; declaring a package removes it from elpaca's ignore list, so
;; the pinned versions win.  Never add those three to the list above.

