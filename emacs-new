      (color-identifiers:refresh))
    (when (and (boundp 'display-line-numbers-mode) display-line-numbers-mode)
      (display-line-numbers-mode nil)
      (display-line-numbers-mode t))
    (redisplay))
  (load-neph-theme default-neph-theme)

